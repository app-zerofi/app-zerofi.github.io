    "index.html": {
      "settings": {
        "main": true,
        "title": "Zerofi™ | Home Official Site",
        "meta_descr": "Deep experience in Solana orderbook-based DEXs. Contributed to optimising every Solana DEX for better MM experience. DEX liquidity at all levels.",
        "header_custom": "",
        "footer_custom": "",
